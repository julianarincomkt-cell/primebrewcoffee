    <div class="grid-product">
      <div class="img-wrapper">
        <img src="https://www.primebrewco.com/cdn/shop/files/639CA6E4-419B-46B1-9766-35363074EE2F_533x.png?v=1775111137" alt="French Vanilla">
      </div>
      <div class="grid-details">
        <h3>French Vanilla</h3>
        <p class="grid-price">$21.99</p>
        <a href="{{ routes.root_url }}products/french-vanilla" class="btn-primary grid-btn">BUY NOW</a>
      </div>
    </div>
  </div>

  <!-- SAMPLE PACKS -->
  <h3 class="category-heading" id="sample-packs">Sample Packs</h3>
  <div class="best-sellers-grid">
    <div class="grid-product">
      <div class="img-wrapper">
        <img src="{{ 'sample_pack.jpg' | asset_url }}" alt="Flavor Collection">
      </div>
      <div class="grid-details">
        <h3>Flavor Collection</h3>
        <p class="grid-price">$24.99</p>
        <a href="{{ routes.root_url }}products/flavored-coffees-sample-pack" class="btn-primary grid-btn">BUY NOW</a>
      </div>
