<!-- PRIME BREW COFFEE — Home Section (Liquid) -->

<!-- Announcement Bar -->
<div class="announcement-bar">
  <div class="marquee">
    <span>FREE SHIPPING ON ALL U.S ORDERS &nbsp;|&nbsp; 10% OFF ON YOUR FIRST ORDER WITH CODE: WELCOME10</span>
  </div>
</div>

<!-- Header / Nav -->
<header id="navbar">
  <div class="logo-container">
    <div class="text-logo">
      <div class="logo-top">PRIME BREW</div>
      <div class="logo-bottom">
        <span class="logo-line"></span>
        <span class="logo-text">COFFEE</span>
        <span class="logo-line"></span>
      </div>
    </div>
  </div>
  <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav id="main-nav">
    <ul id="nav-links">
      {%- if linklists.main-menu != blank -%}
        {%- for link in linklists.main-menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="/">Home</a></li>
        <li><a href="/#blends">Blends</a></li>
        <li><a href="/#flavored">Flavored</a></li>
        <li><a href="/#sample-packs">Sample Packs</a></li>
        <li><a href="/#single-origin">Single Origin</a></li>
        <li><a href="/#tea">Tea</a></li>
        <li><a href="/#contact">Contact</a></li>
      {%- endif -%}
    </ul>
  </nav>
</header>
<div class="nav-overlay" id="nav-overlay"></div>


<!-- Hero Section -->
<section class="hero" id="top">
  <div class="hero-content">
    <h1>Coffee is more than just coffee.<br>It is a <span style="font-style: italic;">ritual.</span></h1>
    <p>In a fast-moving world, we invite you to slow down and reconnect with the moments that matter. Every detail is intentional, from experience to product.</p>
    <div class="hero-buttons">
      <a href="#shop" class="btn-primary">SHOP PRIME BREW COFFEE</a>
      <a href="#origin" class="btn-secondary">OUR STORY</a>
    </div>
  </div>
</section>


<!-- Values / Features Grid -->
<section id="values" class="features">
  <div class="features-header">
    <p>OUR PILLARS</p>
    <h2>The Prime Standard</h2>
  </div>
  <div class="grid-features">
    <div class="feature-card">
      <div class="feature-icon">✨</div>
      <h3 class="feature-title">Intentionality</h3>
      <p>We believe every detail matters, removing the unnecessary to highlight the essential.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🌿</div>
      <h3 class="feature-title">Quality &amp; Purity</h3>
      <p>Carefully sourced, with every detail held to a higher standard.<br>Roasted to order for peak freshness.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">☕</div>
      <h3 class="feature-title">Ritual</h3>
      <p>Coffee is not just consumed — it is experienced. We create space for presence.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">🤝</div>
      <h3 class="feature-title">Connection</h3>
      <p>Making each cup not just something you drink, but something that brings you back to yourself.</p>
    </div>
  </div>
</section>


<!-- Featured Product Showcase -->
<section id="shop" class="product-showcase">
  <!-- Text top -->
  <div class="product-details-top">
    <p class="tag">FLAVORED</p>
    <h2>French Vanilla</h2>
    <p>This rich and creamy vanilla coffee is exceptionally rounded and smooth. The silky flavors blend perfectly with our small-batch roast to elevate your morning routine into a true ritual.</p>
    <p>Organically sourced and roasted with extreme precision to highlight the deep, natural profile without adding acidic bite.</p>
  </div>
  <!-- Product Image -->
  <div class="product-image">
    <img src="https://www.primebrewco.com/cdn/shop/files/639CA6E4-419B-46B1-9766-35363074EE2F_1946x.png?v=1775111137" alt="French Vanilla Coffee">
  </div>
  <!-- Price + CTA -->
  <div class="product-details-bottom">
    <div class="price" style="text-align: center;">$21.99</div>
    <a href="{{ routes.root_url }}products/french-vanilla" class="btn-primary" style="width: 100%; text-align: center; display: block;">BUY NOW</a>
    <p style="font-size: 12px; margin-top: 16px; text-align: center; font-weight: 500; letter-spacing: 1px;">PREMIUM SHIPPING NATIONWIDE</p>
  </div>
</section>


