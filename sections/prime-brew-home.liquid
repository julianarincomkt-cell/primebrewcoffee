  </div>

  <!-- TEA -->
  <h3 class="category-heading" id="tea">Tea</h3>
  <div class="best-sellers-grid">
    <div class="grid-product">
      <div class="img-wrapper">
        <img src="https://www.primebrewco.com/cdn/shop/files/IMG-5547_533x.png?v=1775096078" alt="English Breakfast">
      </div>
      <div class="grid-details">
        <h3>English Breakfast</h3>
