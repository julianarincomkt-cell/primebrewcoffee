    </div>
    <div class="grid-product">
      <div class="img-wrapper">
        <img src="https://www.primebrewco.com/cdn/shop/files/82D50685-06BD-4563-8E7A-B131F2C81B65_533x.png?v=1775110990" alt="Cold Brew">
      </div>
      <div class="grid-details">
        <h3>Cold Brew</h3>
        <p class="grid-price">$21.99</p>
