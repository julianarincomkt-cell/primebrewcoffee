<!-- Our Story -->
<section id="origin" class="impact" style="background-image: linear-gradient(rgba(248, 246, 242, 0.6), rgba(248, 246, 242, 0.8)), url('{{ 'linen_bg.png' | asset_url }}');">
  <div class="impact-content">
    <h2>Our Story</h2>
    <p>Prime Brew Coffee was created with a simple idea: coffee is more than a drink — it's a ritual.</p>
    <p>We set out to create a coffee that feels as good as it tastes — refined, intentional, and made for everyday moments.</p>
    <p>From sourcing to roasting, every detail is considered.</p>
    <p>Because the way you start your day should feel different.</p>
  </div>
</section>


<!-- Mission Section -->
<section id="mission" class="impact">
  <div class="impact-content">
    <h2>Elevate Everyday Moments.</h2>
    <p>Our mission is simple. Coffee should be more than routine — it should be a pause. A reset. A ritual that brings presence into your day. An experience, delivered to you.</p>
    <a href="#shop" class="btn-primary">START YOUR RITUAL</a>
  </div>
</section>


<!-- Newsletter Section -->
<section id="newsletter" class="newsletter">
  <div class="newsletter-content">
    <h2>Join The Ritual</h2>
    <p>Subscribe to receive brewing tips, exclusive offers, and our latest blends directly to your inbox.</p>
    {%- form 'customer', id: 'newsletter_form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form">
        <input type="email" name="contact[email]" id="NewsletterEmail" placeholder="Email address" autocorrect="off" autocapitalize="off" required>
        <button type="submit">→</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-success" style="color: green; margin-top: 12px; font-size: 14px;">✓ Thank you for subscribing!</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>


<!-- Contact Section -->
<section id="contact" class="contact-section">
  <div class="contact-container">
    <h2>Get in Touch</h2>
    <p>Have questions about our roasts or your order? Let's talk.</p>
    {%- form 'contact', id: 'ContactForm' -%}
      <div class="minimal-form">
        <div class="form-row">
          <input type="text" name="contact[name]" placeholder="Your Name" value="{% if form.name %}{{ form.name }}{% endif %}" required>
          <input type="email" name="contact[email]" placeholder="Your Email" value="{% if form.email %}{{ form.email }}{% endif %}" required>
        </div>
        <textarea name="contact[body]" placeholder="Your Message" rows="4" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        <button type="submit" class="btn-primary">SEND MESSAGE</button>
        {%- if form.posted_successfully? -%}
          <p class="form-success" style="color: green; margin-top: 12px; font-size: 14px;">✓ Message sent! We'll be in touch soon.</p>
        {%- endif -%}
      </div>
    {%- endform -%}
  </div>
</section>


<!-- Footer -->
<footer>
  <div class="footer-grid">
    <div class="footer-col">
      <h4>PRIME BREW COFFEE</h4>
      <p style="font-size: 13px; color: var(--text-secondary); max-width: 250px;">We remove the unnecessary to highlight what's essential. This is Prime Brew Coffee.</p>
    </div>
    <div class="footer-col">
      <h4>Policies</h4>
      <ul>
        <li><a href="{{ routes.search_url }}">Search</a></li>
        <li><a href="{{ shop.url }}/policies/shipping-policy">Shipping Information</a></li>
        <li><a href="{{ shop.url }}/policies/refund-policy">Return Policy</a></li>
        <li><a href="{{ shop.url }}/policies/terms-of-service">Terms of Service</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Connect</h4>
      <ul>
        <li><a href="https://instagram.com/primebrewcoffee" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61587316247950" target="_blank" rel="noopener">Facebook</a></li>
        <li><a href="https://www.tiktok.com/@prime.brew.coffee" target="_blank" rel="noopener">TikTok</a></li>
        <li><a href="#contact">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <!-- Payment Icons -->
  <div class="payment-methods">
    {%- for type in shop.enabled_payment_types -%}
      {{ type | payment_type_svg_tag: scale: 1, style: 'height: 24px; width: auto;' }}
    {%- endfor -%}
  </div>

  <div class="copyright">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} LLC. All rights reserved.
  </div>
</footer>

{% schema %}
{
  "name": "Prime Brew Home",
  "tag": "div",
  "settings": []
}
{% endschema %}
