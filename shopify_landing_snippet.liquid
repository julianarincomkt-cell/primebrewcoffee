</div>

<script>
  // Scripts básicos de âncora
  document.querySelectorAll('.prime-brew-custom-landing a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetElement = document.querySelector(this.getAttribute('href'));
      if (targetElement) {
        window.scrollTo({
          top: targetElement.offsetTop - 50,
          behavior: 'smooth'
        });
      }
    });
  });
</script>

<!-- FIM DO BLOCO CUSTOMIZADO PRIME BREW -->
